DATABASE_URL=postgresql://iterum:iterum@localhost:5432/iterum
# Must match Vite dev proxy target (frontend/vite.config.ts → 8181)
PORT=8181
# Comma-separated browser origins allowed by CORS (default: Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Max JSON body size for non-multipart requests
JSON_BODY_LIMIT=1mb
# Durable @qkitt/queue SQLite store (default: server/data/jobs.sqlite)
# JOB_QUEUE_DB_PATH=C:/absolute/path/to/jobs.sqlite
